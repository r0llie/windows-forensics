{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "windows-forensics/schemas/pf_report.schema.json",
  "title": "pf_parse.py JSON report (--report output)",
  "type": "object",
  "required": [
    "tool",
    "tool_version",
    "schema_version",
    "generated_at",
    "mode",
    "inputs",
    "counts",
    "observations",
    "warning_counts",
    "errors",
    "filters",
    "warnings"
  ],
  "properties": {
    "tool": { "const": "pf_parse" },
    "tool_version": { "type": "string" },
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "mode": { "const": "offline" },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "counts": {
      "type": "object",
      "required": ["files", "parsed", "failed", "emitted", "by_version", "total_source_bytes", "total_decompressed_bytes"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "parsed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "emitted": { "type": "integer", "minimum": 0 },
        "by_version": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "total_source_bytes": { "type": "integer", "minimum": 0 },
        "total_decompressed_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "observations": {
      "type": "object",
      "required": ["hash_matches_filename", "exe_matches_filename", "boot_prefetch_files", "note"],
      "properties": {
        "hash_matches_filename": { "$ref": "#/$defs/buckets" },
        "exe_matches_filename": { "$ref": "#/$defs/buckets" },
        "boot_prefetch_files": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      }
    },
    "warning_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "error"],
        "properties": {
          "path": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    },
    "filters": {
      "type": "object",
      "required": ["min_runs", "name_contains", "limit"],
      "properties": {
        "min_runs": { "type": ["integer", "null"] },
        "name_contains": { "type": ["string", "null"] },
        "limit": { "type": ["integer", "null"] }
      }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "no_input_files",
          "files_failed_to_parse",
          "filename_hash_mismatch_present",
          "exe_filename_mismatch_present",
          "header_size_mismatch_present",
          "run_times_not_descending_present",
          "stopped_early_by_limit"
        ]
      }
    }
  },
  "$defs": {
    "buckets": {
      "type": "object",
      "required": ["true", "false", "unknown"],
      "properties": {
        "true": { "type": "integer", "minimum": 0 },
        "false": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
